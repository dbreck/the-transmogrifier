---
import "../styles/global.css";
import { download, repository, version } from "../data/product";
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const {
  title,
  description = "A thoughtful little Mac app for the final mile of image making. Resize, compress and export web-ready images, right on your Mac.",
  ogImage = "/images/social-cover.jpg",
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const links = [
  ["/features/", "The app"],
  ["/docs/", "Field guide"],
  ["/changelog/", "Release notes"],
  ["/pricing/", "Pricing"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e9" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link
      rel="preload"
      href="/fonts/instrument-serif.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dm-sans.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "The Transmogrifier",
        description,
        applicationCategory: "MultimediaApplication",
        operatingSystem: "macOS 12.0+",
        url: "https://thetransmogrifier.app",
        downloadUrl: download,
        screenshot: "https://thetransmogrifier.app/images/app-preview.webp",
        softwareVersion: version,
        offers: { "@type": "Offer", price: "9.99", priceCurrency: "USD" },
        featureList:
          "File-size limits, Responsive WebP and JPG packs, Live comparison, Saved export recipes, Batch history and recovery, Dock quick conversion",
        license: "https://opensource.org/licenses/MIT",
      })}
    />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EGQY1J0Y20"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-EGQY1J0Y20");
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header wrap">
      <a href="/" class="wordmark" aria-label="The Transmogrifier home"
        ><span class="brand-symbol" aria-hidden="true">↳</span><span
          >The<br />Transmogrifier<span class="wordmark-dot">.</span></span
        ></a
      >
      <nav class="desktop-nav" aria-label="Main navigation">
        {
          links.map(([href, label]) => (
            <a
              href={href}
              aria-current={
                Astro.url.pathname.replace(/\/$/, "") ===
                href.replace(/\/$/, "")
                  ? "page"
                  : undefined
              }
            >
              {label}
            </a>
          ))
        }
      </nav>
      <a class="header-download" href={download}
        >Get the app <span aria-hidden="true">↗</span></a
      >
      <button
        class="menu-toggle"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        >Menu <span aria-hidden="true">+</span></button
      >
      <nav
        id="mobile-menu"
        class="mobile-nav"
        aria-label="Mobile navigation"
        hidden
      >
        {links.map(([href, label]) => <a href={href}>{label}</a>)}
        <a href={download}>Download for Mac ↗</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <p>A small tool.<br /><em>A good finish.</em></p><div>
            <a href={download} class="text-link"
              >Download for Mac <span aria-hidden="true">↗</span></a
            ><span class="micro"
              >V{version} / MACOS 12+ / INTEL & APPLE SILICON</span>
          </div>
        </div>
        <div class="newsletter">
          <div>
            <label for="newsletter-email">Notes on the next edition.</label><p>
              Occasional updates. Unsubscribe anytime.
            </p>
          </div><form
            action="https://buttondown.email/api/emails/embed-subscribe/thetransmogrifier"
            method="post"
          >
            <input type="hidden" name="tag" value="transmogrifier" /><input
              id="newsletter-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="Your email address"
              required
            /><button type="submit" aria-label="Subscribe to release updates"
              >Sign me up ↗</button>
          </form>
        </div>
        <div class="footer-bottom">
          <a href="https://clearph.com" class="maker"
            >An independent tool by Clear pH ↗</a
          ><nav aria-label="Footer navigation">
            <a href={repository}>GitHub ↗</a><a href="/docs/">Help</a><a
              href="/privacy/">Privacy</a>
          </nav><span>© {new Date().getFullYear()} The Transmogrifier</span>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("mobile-menu");
      const closeMenu = () => {
        if (menu) menu.hidden = true;
        toggle?.setAttribute("aria-expanded", "false");
      };
      toggle?.addEventListener("click", () => {
        if (!menu) return;
        menu.hidden = !menu.hidden;
        toggle.setAttribute("aria-expanded", String(!menu.hidden));
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu && !menu.hidden) {
          closeMenu();
          toggle?.focus();
        }
      });
      menu
        ?.querySelectorAll("a")
        .forEach((link) => link.addEventListener("click", closeMenu));
      window
        .matchMedia("(min-width: 900px)")
        .addEventListener("change", closeMenu);
    </script>
    <script is:inline>
      document.addEventListener("click", (event) => {
        const link = event.target.closest("a[href]");
        if (!link || typeof gtag !== "function") return;
        if (link.href.includes("releases/download")) {
          gtag("event", "download", {
            event_category: "conversion",
            event_label: link.textContent.trim(),
            link_url: link.href,
          });
          if (link.closest("header"))
            gtag("event", "click", {
              event_category: "conversion",
              event_label: "nav_download_cta",
            });
        } else if (link.href.includes("github.com/dbreck/the-transmogrifier")) {
          gtag("event", "click", {
            event_category: "outbound",
            event_label: "github_repo",
            link_url: link.href,
          });
        }
      });
    </script>
  </body>
</html>
