---
import BaseLayout from "../layouts/BaseLayout.astro";
import sections from "../data/privacy.json";
---

<BaseLayout
  title="Privacy — The Transmogrifier"
  description="How The Transmogrifier handles your images, your local data and your privacy."
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">Privacy / Last updated February 1, 2026</p><h1
        class="display"
      >
        Your images.<br /><em>Your business.</em>
      </h1><p class="body-copy">
        The app works locally on your Mac. Here’s how it handles your
        information.
      </p>
    </header><div class="reading-layout">
      <nav class="contents" aria-label="Privacy policy sections">
        <span class="micro">Privacy policy</span>{
          sections.map(({ id, title }) => <a href={`#${id}`}>{title}</a>)
        }
      </nav><div>
        {
          sections.map(({ id, title, body }) => (
            <section id={id} class="reading-section">
              <>
                <h2>{title}</h2>
                <div set:html={body} />
              </>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
