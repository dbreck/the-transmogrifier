---
import BaseLayout from "../layouts/BaseLayout.astro";
import { download } from "../data/product";
const questions = [
  ["Is this a subscription?", "No. The Transmogrifier is a one-time purchase."],
  [
    "What updates are included?",
    "All minor and patch updates within v1.x are included. Future major versions will be paid upgrades, with discounted pricing for existing customers.",
  ],
  [
    "Can I use it for client work?",
    "Yes. Your license covers personal and commercial work. Each user needs their own license.",
  ],
  [
    "What if it isn’t for me?",
    "There’s a 30-day refund guarantee. Contact info@thetransmogrifier.app for help.",
  ],
  [
    "What about a team?",
    "For five or more licenses, contact info@thetransmogrifier.app to discuss a volume discount.",
  ],
  [
    "Will it run on my Mac?",
    "The app supports Intel and Apple Silicon Macs running macOS 12 Monterey or later. The download is signed with Developer ID and notarized by Apple.",
  ],
];
---

<BaseLayout
  title="Pricing — The Transmogrifier"
  description="The Transmogrifier for Mac. $9.99, one time. Version 1.x updates included, for personal and commercial image work."
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">Pricing / Keep it simple</p><h1 class="display">
        A useful little tool.<br /><em>Yours to keep.</em>
      </h1>
    </header>
    <section class="purchase">
      <div class="purchase-title">
        <img src="/favicon.png" alt="" width="72" height="72" /><h2>
          The Transmogrifier
        </h2><p class="micro">Version 1.2 / For Mac</p><p class="body-copy">
          The complete toolkit for a considered image handoff.
        </p>
      </div><div class="purchase-details">
        <p class="price"><span>$</span>9.99</p><p class="micro muted">
          USD / One time / No subscription
        </p><ul class="rule-list">
          <li>All image export features</li><li>
            Free updates throughout v1.x
          </li><li>Personal and commercial use</li><li>
            30-day refund guarantee
          </li>
        </ul><a href={download} class="button"
          >Download for Mac <span aria-hidden="true">↗</span></a
        ><p class="micro download-note">Apple notarized · macOS 12 and later</p>
      </div>
    </section>
    <section class="questions section">
      <p class="section-label">
        <span>A few details</span> Before you begin
      </p><div>
        {
          questions.map(([question, answer]) => (
            <details>
              <>
                <summary>
                  {question}
                  <span aria-hidden="true">+</span>
                </summary>
                <p>{answer}</p>
              </>
            </details>
          ))
        }<a href="mailto:info@thetransmogrifier.app" class="text-link"
          >Get in touch <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .purchase {
    border-block: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    padding-block: 55px;
  }
  .purchase-title img {
    margin-bottom: 24px;
  }
  .purchase-title h2 {
    font: 46px/1.1 var(--serif);
    letter-spacing: -0.02em;
  }
  .purchase-title .micro {
    margin-top: 15px;
    color: var(--muted);
  }
  .purchase-title .body-copy {
    margin-top: 30px;
    max-width: 350px;
  }
  .price {
    font: 140px/0.9 var(--serif);
    letter-spacing: -0.06em;
    margin-bottom: 20px;
  }
  .price > span {
    font-size: 65px;
    vertical-align: top;
    display: inline-block;
    padding: 10px 10px 0 0;
  }
  .purchase-details .rule-list {
    margin: 30px 0;
    font-size: 14px;
  }
  .download-note {
    font-size: 9px;
    margin-top: 20px;
    color: var(--muted);
  }
  .questions {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 70px;
  }
  .questions details {
    border-top: 1px solid var(--line);
  }
  .questions summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    font-size: 20px;
    cursor: pointer;
    align-items: center;
  }
  .questions summary::-webkit-details-marker {
    display: none;
  }
  .questions summary > span {
    color: var(--red);
    font-size: 24px;
  }
  .questions details[open] summary > span {
    transform: rotate(45deg);
  }
  .questions details p {
    color: var(--muted);
    font-size: 15px;
    padding: 0 40px 25px 0;
  }
  .questions .text-link {
    margin-top: 25px;
  }
  @media (max-width: 899px) {
    .purchase,
    .questions {
      gap: 40px;
    }
    .questions {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 599px) {
    .purchase {
      grid-template-columns: 1fr;
      padding-block: 35px;
      gap: 35px;
    }
    .purchase-title .body-copy {
      margin-top: 20px;
    }
    .purchase-title h2 {
      font-size: 39px;
    }
    .purchase-details {
      border-top: 1px solid var(--line);
      padding-top: 35px;
    }
    .price {
      font-size: 120px;
    }
    .questions summary {
      font-size: 18px;
    }
  }
</style>
