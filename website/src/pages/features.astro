---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExportPackPreview from '../components/ExportPackPreview.astro';
const features = [
  [
    "File-size limits",
    "Set a per-file budget, such as 200 KB, and a minimum acceptable quality. The app searches within your settings and reports outputs that cannot meet the limit."
  ],
  [
    "Responsive image packs",
    "Export several WebP widths at once, with optional JPG fallbacks. Actual-width filenames and copyable srcset values make website handoffs easier."
  ],
  [
    "Live preview and comparison",
    "See actual encoded sizes as settings change. Compare original and export with a wipe, shared zoom, 100% inspection and transparency backgrounds."
  ],
  [
    "Recipes you can reuse",
    "Save format, dimensions, quality, file-size limits, responsive widths, naming and destination together. Existing presets keep their saved encoder quality."
  ],
  [
    "History that helps you finish",
    "Search jobs, reveal outputs, reuse settings, run a batch again or retry unfinished variants. Completed files remain recorded when you cancel."
  ],
  [
    "A faster Mac workflow",
    "Add files with Command-O and export with Command-Return. Designate a saved preset for optional automatic conversion when opening files from Finder or dropping them onto the Dock icon."
  ]
];
---
<BaseLayout title="Features - The Transmogrifier" description="File-size limits, responsive WebP and JPG packs, live comparison, reusable presets and batch recovery in The Transmogrifier 1.2.">
  <section class="py-20 lg:py-28 max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div><p class="text-blue-400 font-semibold mb-5">NEW IN VERSION 1.2</p><h1 class="text-5xl lg:text-6xl font-bold leading-tight mb-6">Prepare once.<br /><span class="gradient-text">Export every size.</span></h1><p class="text-xl text-gray-400 leading-relaxed">From a single image to a complete website handoff, keep quality, dimensions and file sizes under control. Everything runs locally on your Mac.</p></div>
      <ExportPackPreview />
    </div>
  </section>
  <section class="py-20 bg-gray-800/30"><div class="max-w-7xl mx-auto px-6 lg:px-8 grid md:grid-cols-2 lg:grid-cols-3 gap-8">
    {features.map(([title, body], index) => <article class="border-t border-gray-600 pt-7"><span class="text-blue-400 font-mono text-sm">0{index + 1}</span><h2 class="text-2xl font-semibold mt-4 mb-4">{title}</h2><p class="text-gray-400 leading-relaxed">{body}</p></article>)}
  </div></section>
  <section class="py-20 max-w-4xl mx-auto px-6 lg:px-8">
    <h2 class="text-3xl font-bold mb-6">The essentials, included</h2>
    <ul class="list-disc pl-6 space-y-4 text-gray-300">
      <li>Import JPG, PNG, WebP, HEIC, TIFF, BMP, GIF, ICNS and ICO. Export WebP, JPG or lossless PNG.</li>
      <li>Add files or folders in a batch. Include subfolders when you choose to.</li>
      <li>Resize within maximum dimensions while preserving proportions and orientation. Smaller originals are never enlarged.</li>
      <li>Save beside originals or to a chosen folder, with Rename, Skip or Overwrite rules and optional folder preservation.</li>
      <li>Pause, resume and cancel batches. Use the compact layout with the export action always within reach.</li>
      <li>Native SwiftUI interface and Core Image processing. Intel and Apple Silicon support. macOS 12 or later.</li>
    </ul>
  </section>
  <section class="py-16 bg-gray-800/30 text-center px-6"><h2 class="text-3xl font-bold mb-6">Make your next image handoff easier.</h2><a href="https://github.com/dbreck/the-transmogrifier/releases/download/v1.2.0/The.Transmogrifier.1.2.0.dmg" class="inline-flex px-8 py-4 bg-blue-600 hover:bg-blue-700 rounded-lg font-semibold">Download v1.2.0 for macOS</a><p class="mt-5"><a href="/docs/" class="text-blue-400 hover:underline">Read the workflow guide →</a></p></section>
</BaseLayout>
