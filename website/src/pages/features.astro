---
import BaseLayout from "../layouts/BaseLayout.astro";
const features = [
  [
    "01",
    "See what you’re saving.",
    "Live preview & comparison",
    "See actual encoded file sizes as you work. Compare the original and export with a wipe, shared zoom, 100% inspection, and backgrounds for transparent images.",
    "preview",
  ],
  [
    "02",
    "Make the size part of the brief.",
    "File-size limits",
    "Set a per-file budget and the lowest quality you’re happy with. The app finds a fit within your settings, and reports any output that cannot meet the limit.",
    "compression",
  ],
  [
    "03",
    "Send every size together.",
    "Responsive image packs",
    "Export up to eight WebP widths, with optional JPG fallbacks. Actual-width filenames and copyable srcset make the handoff that little bit easier.",
    "responsive",
  ],
  [
    "04",
    "Put a good process on repeat.",
    "Reusable export recipes",
    "Save format, dimensions, quality, size limits, widths, naming, and destination as one preset. The next batch starts with the decisions already made.",
    "presets",
  ],
  [
    "05",
    "Pick up where you left off.",
    "History & recovery",
    "Search jobs, reveal outputs, reuse settings, rerun a batch, or retry unfinished variants. Cancelling a job preserves the work already completed.",
    "history",
  ],
  [
    "06",
    "Keep your hands moving.",
    "A native Mac workflow",
    "Command-O to add. Command-Return to export. Choose a saved preset for optional automatic conversion when you open files from Finder or drop them on the Dock.",
    "keyboard",
  ],
];
---

<BaseLayout
  title="The app — The Transmogrifier"
  description="A closer look at file-size limits, responsive packs, live comparison and reusable recipes in The Transmogrifier for Mac."
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">The app / The details that matter</p><h1
        class="display"
      >
        Consider the image.<br /><em>Then the file.</em>
      </h1><p class="body-copy">
        A focused toolkit for the practical side of image making. Native to your
        Mac, and ready for the way you work.
      </p>
    </header>
    <figure class="feature-image">
      <img
        src="/images/app-preview.webp"
        width="1054"
        height="768"
        alt="The Transmogrifier with live original and export previews, quality controls, and a file-size budget."
      /><figcaption class="micro">
        The Transmogrifier 1.2 / Made for macOS
      </figcaption>
    </figure>
    <div class="feature-list">
      {
        features.map(([number, title, label, body, anchor]) => (
          <article>
            <>
              <span class="micro feature-number">{number}</span>
              <div>
                <>
                  <p class="micro">{label}</p>
                  <h2>{title}</h2>
                </>
              </div>
              <div>
                <>
                  <p class="body-copy">{body}</p>
                  <a href={`/docs/#${anchor}`} class="text-link">
                    How it works <span aria-hidden="true">↗</span>
                  </a>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
    <section class="endnote" id="formats">
      <p class="section-label">
        <span>Specifications</span> The essentials
      </p><div>
        <h2 class="section-heading">Good with your files.</h2><ul
          class="rule-list specs"
        >
          <li>Import JPG, PNG, WebP, HEIC, TIFF, BMP, GIF, ICNS and ICO.</li><li
          >
            Export WebP, JPG or lossless PNG. Still images only.
          </li><li>
            Resize within maximum dimensions. Keep proportions and orientation.
            Smaller originals are never enlarged.
          </li><li>
            Save beside originals or into a chosen folder. Rename, Skip or
            Overwrite rules, with optional folder preservation.
          </li><li>
            Add files or folders in a batch, including subfolders when you
            choose.
          </li><li>Intel and Apple Silicon. macOS 12 Monterey or later.</li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .feature-image {
    padding: 45px;
    background: var(--olive);
    margin-bottom: 75px;
  }
  .feature-image img {
    max-width: 1000px;
    width: 100%;
    margin: auto;
    border-radius: 10px;
    box-shadow: 0 20px 40px -25px #0009;
  }
  .feature-image figcaption {
    margin-top: 25px;
    text-align: center;
    color: var(--muted);
  }
  .feature-list article {
    display: grid;
    grid-template-columns: 55px 1.2fr 1fr;
    gap: 35px;
    padding: 45px 0;
    border-top: 1px solid var(--line);
  }
  .feature-number {
    color: var(--red);
  }
  .feature-list article > div > .micro {
    color: var(--muted);
    margin-bottom: 20px;
  }
  .feature-list h2 {
    font: 48px/1.06 var(--serif);
    letter-spacing: -0.02em;
    max-width: 380px;
  }
  .feature-list .body-copy {
    font-size: 15px;
  }
  .feature-list .text-link {
    margin-top: 15px;
    font-size: 12px;
  }
  .specs {
    margin: 35px 0;
    font-size: 15px;
    color: var(--muted);
  }
  @media (max-width: 899px) {
    .feature-list article {
      grid-template-columns: 35px 1fr;
      gap: 20px;
    }
    .feature-list article > div:last-child {
      grid-column: 2;
    }
    .feature-image {
      padding: 25px;
    }
    .feature-list h2 {
      max-width: none;
    }
  }
  @media (max-width: 599px) {
    .feature-image {
      padding: 15px 10px;
      margin-bottom: 45px;
    }
    .feature-image img {
      border-radius: 5px;
    }
    .feature-image figcaption {
      font-size: 8px;
    }
    .feature-list h2 {
      font-size: 40px;
    }
    .feature-list article {
      padding: 30px 0;
      gap: 15px;
    }
    .feature-list article > div > .micro {
      margin-bottom: 12px;
    }
  }
</style>
