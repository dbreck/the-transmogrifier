---
import BaseLayout from "../layouts/BaseLayout.astro";
import releases from "../data/releases.json";
import { download, repository } from "../data/product";
---

<BaseLayout
  title="Release notes — The Transmogrifier"
  description="The evolving Transmogrifier. Read what's new in version 1.2 and browse the app's release history."
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">Release notes / A work in progress</p><h1
        class="display"
      >
        Small refinements.<br /><em>Better, together.</em>
      </h1><p class="body-copy">
        New capabilities, thoughtful fixes, and the occasional fresh start. A
        record of the work.
      </p>
    </header>
    <div class="releases">
      {
        releases.map(({ version, date, title, items }, i) => (
          <article id={`v${version}`}>
            <>
              <div class="release-meta">
                <time class="micro" datetime={date}>
                  {new Date(date + "T12:00:00Z").toLocaleDateString("en-US", {
                    month: "long",
                    day: "numeric",
                    year: "numeric",
                    timeZone: "UTC",
                  })}
                </time>
                {i === 0 && (
                  <span class="current-label micro">Current release</span>
                )}
              </div>
              <div class="reading-section">
                <>
                  <h2>{title}</h2>
                  <ul>
                    {items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <div class="release-links">
                    <a
                      href={`${repository}/releases/tag/v${version}`}
                      class="text-link"
                    >
                      Read on GitHub <span aria-hidden="true">↗</span>
                    </a>
                    {i === 0 && (
                      <a class="text-link" href={download}>
                        Download 1.2.0 <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </div>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
    <section class="endnote">
      <p class="section-label">
        <span>Looking ahead</span> On the workbench
      </p><div>
        <h2 class="section-heading">There’s more to make.</h2><p
          class="roadmap-copy"
        >
          AVIF, metadata controls, watch folders, and CLI or Shortcuts support
          are ideas we’re exploring. These are future candidates, rather than
          features included in the current app.
        </p><a href={`${repository}/issues/new`} class="text-link"
          >Suggest something useful <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .releases article {
    display: grid;
    grid-template-columns: 270px minmax(0, 1fr);
    gap: 85px;
    border-top: 1px solid var(--line);
    padding: 45px 0;
  }
  .release-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }
  .release-version {
    font: 65px/1 var(--serif);
    letter-spacing: -0.04em;
  }
  .release-meta time {
    color: var(--muted);
  }
  .current-label {
    color: var(--red);
    border: 1px solid var(--red);
    padding: 6px 9px;
  }
  .releases .reading-section {
    border: none;
    margin: 0;
    padding: 0;
  }
  .release-links {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    margin-top: 25px;
  }
  .release-links .text-link {
    font-size: 13px;
    text-decoration: none;
  }
  .endnote {
    margin-bottom: 55px;
  }
  .roadmap-copy {
    margin-top: 25px !important;
    color: var(--muted);
    font-size: 17px !important;
  }
  @media (max-width: 1100px) {
    .releases article {
      gap: 45px;
      grid-template-columns: 225px minmax(0, 1fr);
    }
  }
  @media (max-width: 899px) {
    .releases article {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .release-meta {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }
    .release-version {
      font-size: 50px;
    }
    .release-meta time {
      font-size: 9px;
    }
  }
  @media (max-width: 599px) {
    .releases article {
      padding: 30px 0;
    }
    .current-label {
      font-size: 8px;
    }
    .release-meta {
      gap: 15px;
    }
    .release-version {
      font-size: 42px;
    }
    .release-links {
      gap: 10px 24px;
    }
  }
</style>
