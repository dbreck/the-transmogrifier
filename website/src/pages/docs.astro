---
import BaseLayout from "../layouts/BaseLayout.astro";
import sections from "../data/guide.json";
---

<BaseLayout
  title="Field guide — The Transmogrifier"
  description="A practical guide to installing The Transmogrifier, preparing images, building responsive packs, saving recipes and recovering batches."
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">The field guide / Version 1.2</p><h1 class="display">
        A little know-how.<br /><em>A better workflow.</em>
      </h1><p class="body-copy">
        From your first image to your next hundred. Everything you need to make
        the app your own.
      </p>
    </header>
    <div class="reading-layout">
      <nav class="contents" aria-label="Documentation sections">
        <span class="micro">In this guide</span>{
          sections.map(({ id, title }, i) => (
            <a href={`#${id}`}>
              {String(i + 1).padStart(2, "0")} &nbsp; {title}
            </a>
          ))
        }
      </nav><div>
        {
          sections.map(({ id, title, paragraphs }) => (
            <section id={id} class="reading-section">
              <h2>{title}</h2>
              {paragraphs.map((text) => (
                <p>{text}</p>
              ))}
            </section>
          ))
        }<a
          href="https://github.com/dbreck/the-transmogrifier/issues"
          class="text-link"
          >Still need a hand? <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</BaseLayout>
